# Shared local development environment for `pnpm local` and the wrapper scripts.
# Copy to `.env` and adjust only the sections you actually need.

# ------------------------------------------------------------------------------
# Core local ports
# ------------------------------------------------------------------------------

AGENTYARD_API_PORT=8080
AGENTYARD_WORKER_PORT=8081
AGENTYARD_CHANNEL_GATEWAY_PORT=8082
AGENTYARD_CHANNEL_GATEWAY_BASE_URL=http://127.0.0.1:8082
AGENTYARD_WEB_HOST=0.0.0.0
AGENTYARD_WEB_PORT=5173
AGENTYARD_AGENT_RUNTIME_HOST=127.0.0.1
AGENTYARD_AGENT_RUNTIME_PORT=8090
AGENTYARD_AGENT_RUNTIME_BASE_URL=http://127.0.0.1:8090
AGENTYARD_API_BASE_URL=http://127.0.0.1:8080/api
AGENTYARD_SANDBOX_BASE_URL=http://127.0.0.1:8092
AGENTYARD_KNOWLEDGE_SERVICE_HOST=127.0.0.1
AGENTYARD_KNOWLEDGE_SERVICE_PORT=8091
AGENTYARD_KNOWLEDGE_SERVICE_BASE_URL=http://127.0.0.1:8091

# Extension registration.
# Leave the file path blank to use only the built-in core registrations.
# To test operator registrations, set this to ./extension-registration.example.yaml
# after replacing the example service URLs with reachable extension services.
AGENTYARD_EXTENSION_REGISTRATION_FILE=

# Optional explicit instance id for single-process local debugging.
# Leave blank to use the default auto-generated value.
AGENTYARD_INSTANCE_ID=

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------

AGENTYARD_LOG_FORMAT=json
# Optional per-service log level overrides.
# AGENTYARD_AGENT_RUNTIME_LOG_LEVEL=INFO
# AGENTYARD_KNOWLEDGE_SERVICE_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Internal auth and platform auth
# ------------------------------------------------------------------------------

AGENTYARD_INTERNAL_AUTH_TOKEN=change-me-in-local-dev
AGENTYARD_INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=change-me-integration-credential-key
AGENTYARD_AUTH_BOOTSTRAP_USERNAME=admin
AGENTYARD_AUTH_DEFAULT_ROLE=BUSINESS_USER
AGENTYARD_AUTH_DEV_BOOTSTRAP_ENABLED=true
AGENTYARD_AUTH_LOGIN_SUCCESS_PATH=/
AGENTYARD_WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Redis and shared state
# ------------------------------------------------------------------------------

AGENTYARD_REDIS_HOST=127.0.0.1
AGENTYARD_REDIS_PORT=6379
AGENTYARD_REDIS_DATABASE=0
AGENTYARD_REDIS_USERNAME=
AGENTYARD_REDIS_PASSWORD=agentyard
AGENTYARD_REDIS_SSL_ENABLED=false
AGENTYARD_REDIS_TIMEOUT=3s
AGENTYARD_REDIS_HEALTH_CHECK_ENABLED=true

# Shared-state tuning for distributed locks, idempotency, and runtime SSE replay.
AGENTYARD_SHARED_STATE_LOCK_TTL=10s
AGENTYARD_SHARED_STATE_LOCK_ACQUIRE_TIMEOUT=3s
AGENTYARD_SHARED_STATE_IDEMPOTENCY_TTL=24h
AGENTYARD_SHARED_STATE_SSE_REPLAY_TTL=15m
AGENTYARD_SHARED_STATE_SSE_REPLAY_LIMIT=128
AGENTYARD_SHARED_STATE_STREAM_POLL_INTERVAL=1s

# ------------------------------------------------------------------------------
# API session storage and cookies
# ------------------------------------------------------------------------------

AGENTYARD_SESSION_REDIS_NAMESPACE=agentyard:session:http
AGENTYARD_SESSION_TIMEOUT=12h
AGENTYARD_SESSION_COOKIE_NAME=AGENTYARD_SESSION
AGENTYARD_SESSION_COOKIE_PATH=/
AGENTYARD_SESSION_COOKIE_SECURE=false
AGENTYARD_SESSION_COOKIE_SAME_SITE=Lax

# ------------------------------------------------------------------------------
# Temporal and local dependency images
# ------------------------------------------------------------------------------

AGENTYARD_TEMPORAL_TARGET=127.0.0.1:7233
AGENTYARD_TEMPORAL_UI_USERNAME=observer
AGENTYARD_TEMPORAL_UI_PASSWORD=change-me-temporal-ui
AGENTYARD_TEMPORAL_NAMESPACE=default
AGENTYARD_TEMPORAL_TASK_QUEUE=agentyard-customer-ops
AGENTYARD_TEMPORAL_ACTIVITY_START_TO_CLOSE_TIMEOUT=PT2M

AGENTYARD_IMAGE_POSTGRES=pgvector/pgvector:pg17
AGENTYARD_IMAGE_POSTGRES_BOOTSTRAP=postgres:17.6
AGENTYARD_IMAGE_MINIO=minio/minio:RELEASE.2025-09-07T16-13-09Z
AGENTYARD_IMAGE_TEMPORAL=temporalio/auto-setup:1.28.1
AGENTYARD_IMAGE_TEMPORAL_UI=temporalio/ui:2.39.0
AGENTYARD_IMAGE_CADDY=caddy:2.8.4-alpine
AGENTYARD_IMAGE_REDIS=redis:7.4-alpine
AGENTYARD_IMAGE_SANDBOX=ghcr.io/agent-infra/sandbox:1.0.0.152

# ------------------------------------------------------------------------------
# Databases and object storage
# ------------------------------------------------------------------------------

AGENTYARD_CORE_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/agentyard_core
SPRING_DATASOURCE_USERNAME=agentyard
SPRING_DATASOURCE_PASSWORD=agentyard
AGENTYARD_CHANNEL_GATEWAY_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/agentyard_channel_gateway
AGENTYARD_AGENT_RUNTIME_DATABASE=agentyard_agent_runtime
AGENTYARD_AGENT_RUNTIME_DATABASE_URL=postgresql+psycopg://agentyard:agentyard@127.0.0.1:5432/agentyard_agent_runtime

AGENTYARD_OBJECT_STORAGE_MODE=object-storage
AGENTYARD_OBJECT_STORAGE_ROOT=/tmp/agentyard-knowledge
AGENTYARD_OBJECT_STORAGE_PROVIDER=minio
AGENTYARD_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
AGENTYARD_OBJECT_STORAGE_REGION=
AGENTYARD_OBJECT_STORAGE_ACCESS_KEY=minioadmin
AGENTYARD_OBJECT_STORAGE_SECRET_KEY=minioadmin
AGENTYARD_OBJECT_STORAGE_BUCKET=agentyard-knowledge
AGENTYARD_OBJECT_STORAGE_CREATE_BUCKET=true

# ------------------------------------------------------------------------------
# Knowledge service
# ------------------------------------------------------------------------------

AGENTYARD_KNOWLEDGE_DATABASE_URL=postgresql+psycopg://agentyard:agentyard@127.0.0.1:5432/agentyard_knowledge
AGENTYARD_KNOWLEDGE_DEFAULT_RETRIEVAL_MODE=HYBRID
AGENTYARD_KNOWLEDGE_EMBEDDING_BASE_URL=http://localhost:11434/v1
AGENTYARD_KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text
AGENTYARD_KNOWLEDGE_EMBEDDING_API_KEY=change-me-if-required
AGENTYARD_KNOWLEDGE_EMBEDDING_DIMENSIONS=768
AGENTYARD_KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
AGENTYARD_KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=15
AGENTYARD_KNOWLEDGE_URL_IMPORT_TIMEOUT_SECONDS=15
AGENTYARD_KNOWLEDGE_URL_IMPORT_USER_AGENT=AgentYardKnowledgeService/2.0

# ------------------------------------------------------------------------------
# Agent runtime
# ------------------------------------------------------------------------------

AGENTYARD_AGENT_RUNTIME_TURN_EXECUTION_RETENTION_SECONDS=2592000
AGENTYARD_AGENT_RUNTIME_TRANSCRIPT_ENTRY_RETENTION_SECONDS=2592000
AGENTYARD_AGENT_RUNTIME_RETENTION_SWEEP_LIMIT=500
AGENTYARD_AGENT_RUNTIME_TRANSCRIPT_CACHE_TTL_SECONDS=3600

# Required when privacy mapping is enabled.
AGENTYARD_PRIVACY_SESSION_STORE_ENCRYPTION_KEY=change-me-privacy-key

# Usually keep the default unless you need isolation from another environment.
AGENTYARD_PRIVACY_SESSION_STORE_KEY_PREFIX=agentyard:privacy:session

# Optional safety valve for semantic tool loops in agent runtime.
# Leave blank to use the built-in default.
AGENTYARD_AGENT_RUNTIME_MAX_TOOL_STEPS=

# ------------------------------------------------------------------------------
# Web
# ------------------------------------------------------------------------------

VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# Model providers
# ------------------------------------------------------------------------------

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

AGENTYARD_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
AGENTYARD_OPENAI_COMPATIBLE_MODEL_ID=custom-compatible-model
AGENTYARD_OPENAI_COMPATIBLE_API_KEY_ENV_VAR=OPENAI_COMPATIBLE_API_KEY
AGENTYARD_OPENAI_COMPATIBLE_ORGANIZATION=compatible-lab
AGENTYARD_OPENAI_COMPATIBLE_PROJECT=self-hosted
AGENTYARD_OPENAI_COMPATIBLE_REGION=local
