# Shared local development environment for pnpm local and the wrapper scripts.
# Copy to .env and fill in the provider key you plan to use.

LYNXUS_API_PORT=8080
LYNXUS_WORKER_PORT=8081
LYNXUS_WEB_HOST=0.0.0.0
LYNXUS_WEB_PORT=5173
LYNXUS_AGENT_RUNTIME_HOST=127.0.0.1
LYNXUS_AGENT_RUNTIME_PORT=8090
LYNXUS_AGENT_RUNTIME_BASE_URL=http://127.0.0.1:8090
LYNXUS_SANDBOX_BASE_URL=http://127.0.0.1:8092
LYNXUS_KNOWLEDGE_SERVICE_HOST=127.0.0.1
LYNXUS_KNOWLEDGE_SERVICE_PORT=8091
LYNXUS_KNOWLEDGE_SERVICE_BASE_URL=http://127.0.0.1:8091
LYNXUS_INTERNAL_AUTH_TOKEN=change-me-in-local-dev
LYNXUS_REDIS_HOST=127.0.0.1
LYNXUS_REDIS_PORT=6379
LYNXUS_REDIS_DATABASE=0
LYNXUS_REDIS_USERNAME=
LYNXUS_REDIS_PASSWORD=lynxus
LYNXUS_REDIS_SSL_ENABLED=false
LYNXUS_REDIS_TIMEOUT=3s
LYNXUS_REDIS_HEALTH_CHECK_ENABLED=true

LYNXUS_TEMPORAL_TARGET=127.0.0.1:7233
LYNXUS_TEMPORAL_UI_USERNAME=observer
LYNXUS_TEMPORAL_UI_PASSWORD=change-me-temporal-ui
LYNXUS_TEMPORAL_NAMESPACE=default
LYNXUS_TEMPORAL_TASK_QUEUE=lynxus-customer-ops
LYNXUS_TEMPORAL_ACTIVITY_START_TO_CLOSE_TIMEOUT=PT2M
LYNXUS_IMAGE_POSTGRES=pgvector/pgvector:pg17
LYNXUS_IMAGE_POSTGRES_BOOTSTRAP=postgres:17.6
LYNXUS_IMAGE_MINIO=minio/minio:RELEASE.2025-09-07T16-13-09Z
LYNXUS_IMAGE_TEMPORAL=temporalio/auto-setup:1.28.1
LYNXUS_IMAGE_TEMPORAL_UI=temporalio/ui:2.39.0
LYNXUS_IMAGE_CADDY=caddy:2.8.4-alpine
LYNXUS_IMAGE_REDIS=redis:7.4-alpine
LYNXUS_IMAGE_SANDBOX=ghcr.io/agent-infra/sandbox:1.0.0.152
LYNXUS_CATALOG_SEED_ENABLED=true
LYNXUS_RUNTIME_SEED_ENABLED=true
LYNXUS_RUNTIME_SEED_EXECUTE_OPENING_MESSAGES=false

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/lynxus_core
SPRING_DATASOURCE_USERNAME=lynxus
SPRING_DATASOURCE_PASSWORD=lynxus

LYNXUS_MINIO_ENDPOINT=http://127.0.0.1:9000
LYNXUS_MINIO_ACCESS_KEY=minioadmin
LYNXUS_MINIO_SECRET_KEY=minioadmin
LYNXUS_KNOWLEDGE_DATABASE_URL=postgresql+psycopg://lynxus:lynxus@127.0.0.1:5432/lynxus_knowledge
LYNXUS_KNOWLEDGE_STORAGE_MODE=minio
LYNXUS_KNOWLEDGE_STORAGE_ROOT=/tmp/lynxus-knowledge
LYNXUS_KNOWLEDGE_MINIO_BUCKET=lynxus-knowledge
LYNXUS_KNOWLEDGE_DEFAULT_RETRIEVAL_MODE=HYBRID
LYNXUS_KNOWLEDGE_EMBEDDING_BASE_URL=http://localhost:11434/v1
LYNXUS_KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text
LYNXUS_KNOWLEDGE_EMBEDDING_API_KEY=change-me-if-required
LYNXUS_KNOWLEDGE_EMBEDDING_DIMENSIONS=768
LYNXUS_KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
LYNXUS_KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=15

VITE_API_BASE_URL=/api

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
LYNXUS_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
LYNXUS_OPENAI_COMPATIBLE_MODEL_ID=custom-compatible-model
LYNXUS_OPENAI_COMPATIBLE_API_KEY_ENV_VAR=OPENAI_COMPATIBLE_API_KEY
LYNXUS_OPENAI_COMPATIBLE_ORGANIZATION=compatible-lab
LYNXUS_OPENAI_COMPATIBLE_PROJECT=self-hosted
LYNXUS_OPENAI_COMPATIBLE_REGION=local
