{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentyard.dev/schemas/extension-protocol/channel-provider-descriptor.schema.json",
  "title": "Channel provider descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providerType",
    "title",
    "accountConfigSchema",
    "accountConfigUiSchema",
    "configSchema",
    "configUiSchema",
    "outbound",
    "endpoints"
  ],
  "properties": {
    "providerType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "accountConfigSchema": {
      "type": "object"
    },
    "accountConfigUiSchema": {
      "$ref": "ui-field.schema.json"
    },
    "credentialSchema": {
      "type": "object"
    },
    "credentialUiSchema": {
      "$ref": "ui-field.schema.json"
    },
    "credentialLifecycleEndpointProfile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "configSchema": {
      "type": "object"
    },
    "configUiSchema": {
      "$ref": "ui-field.schema.json"
    },
    "defaultConfig": {
      "type": "object"
    },
    "jobDefinitions": {
      "type": "array",
      "items": {
        "$ref": "job-definition.schema.json"
      }
    },
    "outbound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "supportsTyping",
        "supportsDraftUpdate",
        "supportsFinalDelivery",
        "requiresIdempotentFinalDelivery"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "const": "FRAME_STREAM"
        },
        "supportsTyping": {
          "type": "boolean"
        },
        "supportsDraftUpdate": {
          "type": "boolean"
        },
        "supportsFinalDelivery": {
          "type": "boolean",
          "const": true
        },
        "requiresIdempotentFinalDelivery": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runJob": {
          "$ref": "#/$defs/declaredPath"
        }
      }
    }
  },
  "$defs": {
    "declaredPath": {
      "type": "string",
      "pattern": "^/[^?#]*$"
    }
  }
}
