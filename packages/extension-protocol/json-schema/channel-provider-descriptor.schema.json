{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lynxus.dev/schemas/extension-protocol/channel-provider-descriptor.schema.json",
  "title": "Channel provider descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providerType",
    "title",
    "accountConfigSchema",
    "accountConfigUiSchema",
    "configSchema",
    "configUiSchema",
    "endpoints"
  ],
  "properties": {
    "providerType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "accountConfigSchema": {
      "type": "object"
    },
    "accountConfigUiSchema": {
      "$ref": "ui-field.schema.json"
    },
    "credentialSchema": {
      "type": "object"
    },
    "credentialUiSchema": {
      "$ref": "ui-field.schema.json"
    },
    "configSchema": {
      "type": "object"
    },
    "configUiSchema": {
      "$ref": "ui-field.schema.json"
    },
    "defaultConfig": {
      "type": "object"
    },
    "jobDefinitions": {
      "type": "array",
      "items": {
        "$ref": "job-definition.schema.json"
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typing": {
          "type": "boolean",
          "default": false
        },
        "draftUpdate": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sendOutbound"],
      "properties": {
        "sendOutbound": {
          "$ref": "#/$defs/declaredPath"
        },
        "sendActivity": {
          "$ref": "#/$defs/declaredPath"
        },
        "runJob": {
          "$ref": "#/$defs/declaredPath"
        },
        "createCredential": {
          "$ref": "#/$defs/declaredPath"
        },
        "rotateCredential": {
          "$ref": "#/$defs/declaredPath"
        },
        "revokeCredential": {
          "$ref": "#/$defs/declaredPath"
        },
        "validateCredential": {
          "$ref": "#/$defs/declaredPath"
        }
      }
    }
  },
  "$defs": {
    "declaredPath": {
      "type": "string",
      "pattern": "^/[^?#]*$"
    }
  }
}
