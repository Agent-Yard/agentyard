# Test deployment environment.
# This template is split by variable lifecycle:
# - Build/release-time variables are used by the release pipeline to produce or
#   select deployable artifacts. Web build variables are baked into static assets.
# - Runtime variables are read by Docker Compose or by containers when a module
#   starts on a test host.
#
# Copy the image selector sections and runtime sections to `.env` on each target
# host, then keep only the variables needed by that host. Keep the web build-time
# section in the release pipeline because static assets are compiled before they
# are published to the Nginx host.

# ------------------------------------------------------------------------------
# Build/release-time: AgentYard application images
# ------------------------------------------------------------------------------
#
# The Java and Python application images do not have test-specific compile-time
# environment variables. The release pipeline builds these images from source,
# tags them, pushes them, and then the test deployment selects the exact tag here.
# ------------------------------------------------------------------------------

AGENTYARD_IMAGE_API=registry.example.com/agentyard/api:2026.04.25-1
AGENTYARD_IMAGE_WORKER=registry.example.com/agentyard/worker:2026.04.25-1
AGENTYARD_IMAGE_CHANNEL_GATEWAY=registry.example.com/agentyard/channel-gateway:2026.04.25-1
AGENTYARD_IMAGE_KNOWLEDGE_SERVICE=registry.example.com/agentyard/knowledge-service:2026.04.25-1
AGENTYARD_IMAGE_AGENT_RUNTIME=registry.example.com/agentyard/agent-runtime:2026.04.25-1

# ------------------------------------------------------------------------------
# Build/release-time: third-party runtime images
# ------------------------------------------------------------------------------
#
# These are not built by the AgentYard release pipeline. They select the upstream
# runtime images used by the optional infrastructure modules.
# ------------------------------------------------------------------------------

AGENTYARD_IMAGE_SANDBOX=ghcr.io/agent-infra/sandbox:1.0.0.152
AGENTYARD_IMAGE_POSTGRES=pgvector/pgvector:pg17
AGENTYARD_IMAGE_POSTGRES_BOOTSTRAP=postgres:17.6
AGENTYARD_IMAGE_TEMPORAL=temporalio/auto-setup:1.28.1
AGENTYARD_IMAGE_TEMPORAL_UI=temporalio/ui:2.39.0
AGENTYARD_IMAGE_CADDY=caddy:2.8.4-alpine

# ------------------------------------------------------------------------------
# Build-time: web static assets
# ------------------------------------------------------------------------------
#
# These values are read by Vite when building apps/web/dist. They are not runtime
# container variables; changing them after publishing the dist files has no effect.
# ------------------------------------------------------------------------------

VITE_API_BASE_URL=/api
VITE_DEPLOY_ENV=test

# ------------------------------------------------------------------------------
# Runtime: profile and public origin
# ------------------------------------------------------------------------------

SPRING_PROFILES_ACTIVE=test
AGENTYARD_LOG_FORMAT=json
AGENTYARD_PUBLIC_BASE_URL=https://test.agentyard.example.com
AGENTYARD_WEB_ALLOWED_ORIGINS=https://test.agentyard.example.com

# ------------------------------------------------------------------------------
# Runtime: per-service host bindings
# ------------------------------------------------------------------------------

AGENTYARD_API_BIND_ADDRESS=0.0.0.0
AGENTYARD_API_PORT=8080
AGENTYARD_WORKER_PORT=8081
AGENTYARD_CHANNEL_GATEWAY_BIND_ADDRESS=0.0.0.0
AGENTYARD_CHANNEL_GATEWAY_PORT=8082
AGENTYARD_AGENT_RUNTIME_BIND_ADDRESS=0.0.0.0
AGENTYARD_AGENT_RUNTIME_PORT=8090
AGENTYARD_KNOWLEDGE_SERVICE_BIND_ADDRESS=0.0.0.0
AGENTYARD_KNOWLEDGE_SERVICE_PORT=8091
AGENTYARD_SANDBOX_BIND_ADDRESS=0.0.0.0
AGENTYARD_SANDBOX_PORT=8092
AGENTYARD_POSTGRES_BIND_ADDRESS=0.0.0.0
AGENTYARD_POSTGRES_PORT=5432
AGENTYARD_TEMPORAL_BIND_ADDRESS=0.0.0.0
AGENTYARD_TEMPORAL_PORT=7233
AGENTYARD_TEMPORAL_UI_BIND_ADDRESS=127.0.0.1
AGENTYARD_TEMPORAL_UI_PORT=8088

# ------------------------------------------------------------------------------
# Runtime: cross-service private URLs
# ------------------------------------------------------------------------------

AGENTYARD_API_BASE_URL=http://api-test.internal:8080/api
AGENTYARD_CHANNEL_GATEWAY_BASE_URL=http://channel-gateway-test.internal:8082
AGENTYARD_KNOWLEDGE_SERVICE_BASE_URL=http://knowledge-service-test.internal:8091
AGENTYARD_AGENT_RUNTIME_BASE_URL=http://agent-runtime-test.internal:8090
AGENTYARD_SANDBOX_BASE_URL=http://sandbox-test.internal:8092

# Extension registration.
# Leave the file path blank to use only the built-in core registrations.
# In containerized deployments, mount the operator registration YAML and set
# this to the in-container path, for example /etc/agentyard/extensions.yaml.
AGENTYARD_EXTENSION_REGISTRATION_FILE=

# ------------------------------------------------------------------------------
# Runtime: internal authentication, platform auth, and cookies
# ------------------------------------------------------------------------------

AGENTYARD_INTERNAL_AUTH_TOKEN=replace-with-long-random-token
AGENTYARD_INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-credential-encryption-key
AGENTYARD_PRIVACY_SESSION_STORE_ENCRYPTION_KEY=replace-with-privacy-encryption-key

AGENTYARD_AUTH_DEV_BOOTSTRAP_ENABLED=false
AGENTYARD_AUTH_LOGIN_SUCCESS_PATH=/
AGENTYARD_AUTH_DEFAULT_ROLE=BUSINESS_USER

AGENTYARD_SESSION_TIMEOUT=12h
AGENTYARD_SESSION_COOKIE_NAME=AGENTYARD_SESSION
AGENTYARD_SESSION_COOKIE_PATH=/
AGENTYARD_SESSION_COOKIE_SECURE=true
AGENTYARD_SESSION_COOKIE_SAME_SITE=Lax

SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_CLIENT_ID=replace-me
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_CLIENT_SECRET=replace-me
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_SCOPE=openid,profile,email
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_CORP_ISSUER_URI=https://idp.example.com/realms/agentyard-test

# ------------------------------------------------------------------------------
# Runtime: PostgreSQL 16+; PostgreSQL 17 is recommended.
# Knowledge database requires pgvector with HNSW support and pg_trgm.
# ------------------------------------------------------------------------------

AGENTYARD_CORE_DATASOURCE_URL=jdbc:postgresql://postgres-test.internal:5432/agentyard_core
SPRING_DATASOURCE_USERNAME=agentyard_test
SPRING_DATASOURCE_PASSWORD=replace-me
AGENTYARD_CHANNEL_GATEWAY_DATASOURCE_URL=jdbc:postgresql://postgres-test.internal:5432/agentyard_channel_gateway

AGENTYARD_KNOWLEDGE_DATABASE_URL=postgresql+psycopg://agentyard_test:replace-me@postgres-test.internal:5432/agentyard_knowledge
AGENTYARD_AGENT_RUNTIME_DATABASE_URL=postgresql+psycopg://agentyard_test:replace-me@postgres-test.internal:5432/agentyard_agent_runtime

AGENTYARD_POSTGRES_ADMIN_USER=postgres
AGENTYARD_POSTGRES_ADMIN_PASSWORD=replace-me
AGENTYARD_CORE_DATABASE=agentyard_core
AGENTYARD_CHANNEL_GATEWAY_DATABASE=agentyard_channel_gateway
AGENTYARD_KNOWLEDGE_DATABASE=agentyard_knowledge
AGENTYARD_AGENT_RUNTIME_DATABASE=agentyard_agent_runtime

# ------------------------------------------------------------------------------
# Runtime: existing Redis
# ------------------------------------------------------------------------------

AGENTYARD_REDIS_HOST=redis-test.internal
AGENTYARD_REDIS_PORT=6379
AGENTYARD_REDIS_DATABASE=0
AGENTYARD_REDIS_USERNAME=
AGENTYARD_REDIS_PASSWORD=replace-me
AGENTYARD_REDIS_SSL_ENABLED=true
AGENTYARD_REDIS_TIMEOUT=3s
AGENTYARD_REDIS_HEALTH_CHECK_ENABLED=true

AGENTYARD_REDIS_KEY_PREFIX=agentyard:test
AGENTYARD_SESSION_REDIS_NAMESPACE=agentyard:test:session:http
AGENTYARD_PRIVACY_SESSION_STORE_KEY_PREFIX=agentyard:test:privacy:session

AGENTYARD_SHARED_STATE_LOCK_TTL=10s
AGENTYARD_SHARED_STATE_LOCK_ACQUIRE_TIMEOUT=3s
AGENTYARD_SHARED_STATE_IDEMPOTENCY_TTL=24h
AGENTYARD_SHARED_STATE_SSE_REPLAY_TTL=15m
AGENTYARD_SHARED_STATE_SSE_REPLAY_LIMIT=128
AGENTYARD_SHARED_STATE_STREAM_POLL_INTERVAL=1s

# ------------------------------------------------------------------------------
# Runtime: Temporal
# ------------------------------------------------------------------------------

AGENTYARD_TEMPORAL_TARGET=temporal-test.internal:7233
AGENTYARD_TEMPORAL_NAMESPACE=agentyard-test
AGENTYARD_TEMPORAL_TASK_QUEUE=agentyard-customer-ops-test
AGENTYARD_TEMPORAL_ACTIVITY_START_TO_CLOSE_TIMEOUT=PT2M

AGENTYARD_TEMPORAL_POSTGRES_HOST=postgres-test.internal
AGENTYARD_TEMPORAL_POSTGRES_PORT=5432
AGENTYARD_TEMPORAL_POSTGRES_USER=agentyard_temporal
AGENTYARD_TEMPORAL_POSTGRES_PASSWORD=replace-me
AGENTYARD_TEMPORAL_DATABASE=temporal
AGENTYARD_TEMPORAL_VISIBILITY_DATABASE=temporal_visibility
AGENTYARD_TEMPORAL_UI_TARGET=temporal-test.internal:7233
AGENTYARD_TEMPORAL_UI_USERNAME=observer
AGENTYARD_TEMPORAL_UI_PASSWORD=replace-with-temporal-ui-password

# ------------------------------------------------------------------------------
# Runtime: existing S3-compatible object storage
# ------------------------------------------------------------------------------

AGENTYARD_OBJECT_STORAGE_MODE=object-storage
AGENTYARD_OBJECT_STORAGE_PROVIDER=s3
AGENTYARD_OBJECT_STORAGE_ENDPOINT=https://s3-compatible.example.com
AGENTYARD_OBJECT_STORAGE_REGION=us-east-1
AGENTYARD_OBJECT_STORAGE_ACCESS_KEY=replace-me
AGENTYARD_OBJECT_STORAGE_SECRET_KEY=replace-me
AGENTYARD_OBJECT_STORAGE_BUCKET=agentyard-test-knowledge
AGENTYARD_OBJECT_STORAGE_CREATE_BUCKET=false

# ------------------------------------------------------------------------------
# Runtime: knowledge service
# ------------------------------------------------------------------------------

AGENTYARD_KNOWLEDGE_DEFAULT_RETRIEVAL_MODE=HYBRID
AGENTYARD_KNOWLEDGE_EMBEDDING_BASE_URL=https://embedding.example.com/v1
AGENTYARD_KNOWLEDGE_EMBEDDING_MODEL=replace-me
AGENTYARD_KNOWLEDGE_EMBEDDING_API_KEY=replace-me
AGENTYARD_KNOWLEDGE_EMBEDDING_DIMENSIONS=768
AGENTYARD_KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
AGENTYARD_KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=15
AGENTYARD_KNOWLEDGE_URL_IMPORT_TIMEOUT_SECONDS=15
AGENTYARD_KNOWLEDGE_URL_IMPORT_USER_AGENT=AgentYardKnowledgeService/2.0

# ------------------------------------------------------------------------------
# Runtime: agent runtime
# ------------------------------------------------------------------------------

AGENTYARD_AGENT_RUNTIME_TURN_EXECUTION_RETENTION_SECONDS=2592000
AGENTYARD_AGENT_RUNTIME_TRANSCRIPT_ENTRY_RETENTION_SECONDS=2592000
AGENTYARD_AGENT_RUNTIME_RETENTION_SWEEP_LIMIT=500
AGENTYARD_AGENT_RUNTIME_TRANSCRIPT_CACHE_TTL_SECONDS=3600
AGENTYARD_AGENT_RUNTIME_MAX_TOOL_STEPS=

# ------------------------------------------------------------------------------
# Runtime: model providers
# ------------------------------------------------------------------------------

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

AGENTYARD_OPENAI_COMPATIBLE_BASE_URL=
AGENTYARD_OPENAI_COMPATIBLE_MODEL_ID=
AGENTYARD_OPENAI_COMPATIBLE_API_KEY_ENV_VAR=OPENAI_COMPATIBLE_API_KEY
AGENTYARD_OPENAI_COMPATIBLE_ORGANIZATION=
AGENTYARD_OPENAI_COMPATIBLE_PROJECT=
AGENTYARD_OPENAI_COMPATIBLE_REGION=test

# ------------------------------------------------------------------------------
# Runtime: instance ids
# ------------------------------------------------------------------------------

AGENTYARD_API_INSTANCE_ID=api-test-1
AGENTYARD_WORKER_INSTANCE_ID=worker-test-1
AGENTYARD_CHANNEL_GATEWAY_INSTANCE_ID=channel-gateway-test-1
AGENTYARD_AGENT_RUNTIME_INSTANCE_ID=agent-runtime-test-1
AGENTYARD_KNOWLEDGE_INSTANCE_ID=knowledge-service-test-1
