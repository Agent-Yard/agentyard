# Test deployment environment.
# Copy this file to `.env` on each target host and keep only the variables needed by that host.

# ------------------------------------------------------------------------------
# Images
# ------------------------------------------------------------------------------

LYNXUS_IMAGE_API=registry.example.com/lynxus/api:2026.04.25-1
LYNXUS_IMAGE_WORKER=registry.example.com/lynxus/worker:2026.04.25-1
LYNXUS_IMAGE_CHANNEL_GATEWAY=registry.example.com/lynxus/channel-gateway:2026.04.25-1
LYNXUS_IMAGE_KNOWLEDGE_SERVICE=registry.example.com/lynxus/knowledge-service:2026.04.25-1
LYNXUS_IMAGE_AGENT_RUNTIME=registry.example.com/lynxus/agent-runtime:2026.04.25-1
LYNXUS_IMAGE_SANDBOX=ghcr.io/agent-infra/sandbox:1.0.0.152
LYNXUS_IMAGE_POSTGRES=pgvector/pgvector:pg17
LYNXUS_IMAGE_POSTGRES_BOOTSTRAP=postgres:17.6
LYNXUS_IMAGE_TEMPORAL=temporalio/auto-setup:1.28.1
LYNXUS_IMAGE_TEMPORAL_UI=temporalio/ui:2.39.0

# ------------------------------------------------------------------------------
# Runtime profile and public origin
# ------------------------------------------------------------------------------

SPRING_PROFILES_ACTIVE=test
LYNXUS_LOG_FORMAT=json
LYNXUS_PUBLIC_BASE_URL=https://test.lynxus.example.com
LYNXUS_WEB_ALLOWED_ORIGINS=https://test.lynxus.example.com

# ------------------------------------------------------------------------------
# Per-service host bindings
# ------------------------------------------------------------------------------

LYNXUS_API_BIND_ADDRESS=0.0.0.0
LYNXUS_API_PORT=8080
LYNXUS_WORKER_PORT=8081
LYNXUS_CHANNEL_GATEWAY_BIND_ADDRESS=0.0.0.0
LYNXUS_CHANNEL_GATEWAY_PORT=8082
LYNXUS_AGENT_RUNTIME_BIND_ADDRESS=0.0.0.0
LYNXUS_AGENT_RUNTIME_PORT=8090
LYNXUS_KNOWLEDGE_SERVICE_BIND_ADDRESS=0.0.0.0
LYNXUS_KNOWLEDGE_SERVICE_PORT=8091
LYNXUS_SANDBOX_BIND_ADDRESS=0.0.0.0
LYNXUS_SANDBOX_PORT=8092
LYNXUS_POSTGRES_BIND_ADDRESS=0.0.0.0
LYNXUS_POSTGRES_PORT=5432
LYNXUS_TEMPORAL_BIND_ADDRESS=0.0.0.0
LYNXUS_TEMPORAL_PORT=7233
LYNXUS_TEMPORAL_UI_BIND_ADDRESS=127.0.0.1
LYNXUS_TEMPORAL_UI_PORT=8088

# ------------------------------------------------------------------------------
# Cross-service private URLs
# ------------------------------------------------------------------------------

LYNXUS_API_BASE_URL=http://api-test.internal:8080/api
LYNXUS_CHANNEL_GATEWAY_BASE_URL=http://channel-gateway-test.internal:8082
LYNXUS_KNOWLEDGE_SERVICE_BASE_URL=http://knowledge-service-test.internal:8091
LYNXUS_AGENT_RUNTIME_BASE_URL=http://agent-runtime-test.internal:8090
LYNXUS_SANDBOX_BASE_URL=http://sandbox-test.internal:8092

# Extension registration.
# Leave the file path blank to use only the built-in core registrations.
# In containerized deployments, mount the operator registration YAML and set
# this to the in-container path, for example /etc/lynxus/extensions.yaml.
LYNXUS_EXTENSION_REGISTRATION_FILE=

# ------------------------------------------------------------------------------
# Internal authentication, platform auth, and cookies
# ------------------------------------------------------------------------------

LYNXUS_INTERNAL_AUTH_TOKEN=replace-with-long-random-token
LYNXUS_INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-credential-encryption-key
LYNXUS_PRIVACY_SESSION_STORE_ENCRYPTION_KEY=replace-with-privacy-encryption-key

LYNXUS_AUTH_DEV_BOOTSTRAP_ENABLED=false
LYNXUS_AUTH_LOGIN_SUCCESS_PATH=/
LYNXUS_AUTH_DEFAULT_ROLE=BUSINESS_USER

LYNXUS_SESSION_TIMEOUT=12h
LYNXUS_SESSION_COOKIE_NAME=LYNXUS_SESSION
LYNXUS_SESSION_COOKIE_PATH=/
LYNXUS_SESSION_COOKIE_SECURE=true
LYNXUS_SESSION_COOKIE_SAME_SITE=Lax

SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_CLIENT_ID=replace-me
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_CLIENT_SECRET=replace-me
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_SCOPE=openid,profile,email
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_CORP_ISSUER_URI=https://idp.example.com/realms/lynxus-test

# ------------------------------------------------------------------------------
# PostgreSQL 16+; PostgreSQL 17 is recommended.
# Knowledge database requires pgvector with HNSW support and pg_trgm.
# ------------------------------------------------------------------------------

LYNXUS_CORE_DATASOURCE_URL=jdbc:postgresql://postgres-test.internal:5432/lynxus_core
SPRING_DATASOURCE_USERNAME=lynxus_test
SPRING_DATASOURCE_PASSWORD=replace-me
LYNXUS_CHANNEL_GATEWAY_DATASOURCE_URL=jdbc:postgresql://postgres-test.internal:5432/lynxus_channel_gateway

LYNXUS_KNOWLEDGE_DATABASE_URL=postgresql+psycopg://lynxus_test:replace-me@postgres-test.internal:5432/lynxus_knowledge

LYNXUS_POSTGRES_ADMIN_USER=postgres
LYNXUS_POSTGRES_ADMIN_PASSWORD=replace-me
LYNXUS_CORE_DATABASE=lynxus_core
LYNXUS_CHANNEL_GATEWAY_DATABASE=lynxus_channel_gateway
LYNXUS_KNOWLEDGE_DATABASE=lynxus_knowledge

# ------------------------------------------------------------------------------
# Existing Redis
# ------------------------------------------------------------------------------

LYNXUS_REDIS_HOST=redis-test.internal
LYNXUS_REDIS_PORT=6379
LYNXUS_REDIS_DATABASE=0
LYNXUS_REDIS_USERNAME=
LYNXUS_REDIS_PASSWORD=replace-me
LYNXUS_REDIS_SSL_ENABLED=true
LYNXUS_REDIS_TIMEOUT=3s
LYNXUS_REDIS_HEALTH_CHECK_ENABLED=true

LYNXUS_REDIS_KEY_PREFIX=lynxus:test
LYNXUS_SESSION_REDIS_NAMESPACE=lynxus:test:session:http
LYNXUS_PRIVACY_SESSION_STORE_KEY_PREFIX=lynxus:test:privacy:session

LYNXUS_SHARED_STATE_LOCK_TTL=10s
LYNXUS_SHARED_STATE_LOCK_ACQUIRE_TIMEOUT=3s
LYNXUS_SHARED_STATE_IDEMPOTENCY_TTL=24h
LYNXUS_SHARED_STATE_SSE_REPLAY_TTL=15m
LYNXUS_SHARED_STATE_SSE_REPLAY_LIMIT=128
LYNXUS_SHARED_STATE_STREAM_POLL_INTERVAL=1s

# ------------------------------------------------------------------------------
# Temporal
# ------------------------------------------------------------------------------

LYNXUS_TEMPORAL_TARGET=temporal-test.internal:7233
LYNXUS_TEMPORAL_NAMESPACE=lynxus-test
LYNXUS_TEMPORAL_TASK_QUEUE=lynxus-customer-ops-test
LYNXUS_TEMPORAL_ACTIVITY_START_TO_CLOSE_TIMEOUT=PT2M

LYNXUS_TEMPORAL_POSTGRES_HOST=postgres-test.internal
LYNXUS_TEMPORAL_POSTGRES_PORT=5432
LYNXUS_TEMPORAL_POSTGRES_USER=lynxus_temporal
LYNXUS_TEMPORAL_POSTGRES_PASSWORD=replace-me
LYNXUS_TEMPORAL_DATABASE=temporal
LYNXUS_TEMPORAL_VISIBILITY_DATABASE=temporal_visibility
LYNXUS_TEMPORAL_UI_TARGET=temporal-test.internal:7233

# ------------------------------------------------------------------------------
# Existing S3-compatible object storage
# ------------------------------------------------------------------------------

LYNXUS_OBJECT_STORAGE_MODE=object-storage
LYNXUS_OBJECT_STORAGE_PROVIDER=s3
LYNXUS_OBJECT_STORAGE_ENDPOINT=https://s3-compatible.example.com
LYNXUS_OBJECT_STORAGE_REGION=us-east-1
LYNXUS_OBJECT_STORAGE_ACCESS_KEY=replace-me
LYNXUS_OBJECT_STORAGE_SECRET_KEY=replace-me
LYNXUS_OBJECT_STORAGE_BUCKET=lynxus-test-knowledge
LYNXUS_OBJECT_STORAGE_CREATE_BUCKET=false

# ------------------------------------------------------------------------------
# Knowledge service
# ------------------------------------------------------------------------------

LYNXUS_KNOWLEDGE_DEFAULT_RETRIEVAL_MODE=HYBRID
LYNXUS_KNOWLEDGE_EMBEDDING_BASE_URL=https://embedding.example.com/v1
LYNXUS_KNOWLEDGE_EMBEDDING_MODEL=replace-me
LYNXUS_KNOWLEDGE_EMBEDDING_API_KEY=replace-me
LYNXUS_KNOWLEDGE_EMBEDDING_DIMENSIONS=768
LYNXUS_KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
LYNXUS_KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=15
LYNXUS_KNOWLEDGE_URL_IMPORT_TIMEOUT_SECONDS=15
LYNXUS_KNOWLEDGE_URL_IMPORT_USER_AGENT=LynxusKnowledgeService/2.0

# ------------------------------------------------------------------------------
# Model providers
# ------------------------------------------------------------------------------

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

LYNXUS_OPENAI_COMPATIBLE_BASE_URL=
LYNXUS_OPENAI_COMPATIBLE_MODEL_ID=
LYNXUS_OPENAI_COMPATIBLE_API_KEY_ENV_VAR=OPENAI_COMPATIBLE_API_KEY
LYNXUS_OPENAI_COMPATIBLE_ORGANIZATION=
LYNXUS_OPENAI_COMPATIBLE_PROJECT=
LYNXUS_OPENAI_COMPATIBLE_REGION=test

# ------------------------------------------------------------------------------
# Instance ids
# ------------------------------------------------------------------------------

LYNXUS_API_INSTANCE_ID=api-test-1
LYNXUS_WORKER_INSTANCE_ID=worker-test-1
LYNXUS_CHANNEL_GATEWAY_INSTANCE_ID=channel-gateway-test-1
LYNXUS_AGENT_RUNTIME_INSTANCE_ID=agent-runtime-test-1
LYNXUS_KNOWLEDGE_INSTANCE_ID=knowledge-service-test-1
