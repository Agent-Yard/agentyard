# Development environment for server-side shared debugging.
# Copy to .env.dev and adjust external hostnames, credentials, and model keys.

SPRING_PROFILES_ACTIVE=dev
LYNXUS_LOG_FORMAT=json

LYNXUS_WEB_HOST=0.0.0.0
LYNXUS_WEB_PORT=5173
LYNXUS_WEB_DEV_PROXY_TARGET=http://127.0.0.1:8080
LYNXUS_WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://devbox.example.com:5173,http://devbox.example.com:8080
LYNXUS_WEB_ALLOWED_HOSTS=devbox.example.com
LYNXUS_WEB_HMR_PROTOCOL=wss
LYNXUS_WEB_HMR_HOST=devbox.example.com
LYNXUS_WEB_HMR_CLIENT_PORT=443
# Optional: only set when the HMR websocket is exposed on a different upstream port than the browser-facing port.
# LYNXUS_WEB_HMR_PORT=5173

LYNXUS_API_PORT=8080
LYNXUS_WORKER_PORT=8081
LYNXUS_AGENT_RUNTIME_HOST=0.0.0.0
LYNXUS_AGENT_RUNTIME_PORT=8090
LYNXUS_AGENT_RUNTIME_BASE_URL=http://127.0.0.1:8090
LYNXUS_KNOWLEDGE_SERVICE_HOST=0.0.0.0
LYNXUS_KNOWLEDGE_SERVICE_PORT=8091
LYNXUS_KNOWLEDGE_SERVICE_BASE_URL=http://127.0.0.1:8091
LYNXUS_INTERNAL_AUTH_TOKEN=change-me-in-dev

LYNXUS_AUTH_DEV_BOOTSTRAP_ENABLED=true

# OIDC example for Spring Security oauth2Login.
# When you disable dev bootstrap, at least one client registration must exist.
# Replace `CORP` with your chosen registration id if needed.
# LYNXUS_AUTH_DEV_BOOTSTRAP_ENABLED=false
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_CLIENT_ID=your-client-id
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_CLIENT_SECRET=your-client-secret
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_SCOPE=openid,profile,email
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}
# SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_CORP_ISSUER_URI=https://your-idp.example.com/realms/your-realm

LYNXUS_TEMPORAL_TARGET=127.0.0.1:7233
LYNXUS_TEMPORAL_UI_USERNAME=observer
LYNXUS_TEMPORAL_UI_PASSWORD=change-me-temporal-ui
LYNXUS_TEMPORAL_NAMESPACE=default
LYNXUS_TEMPORAL_TASK_QUEUE=lynxus-customer-ops
LYNXUS_TEMPORAL_ACTIVITY_START_TO_CLOSE_TIMEOUT=PT2M
LYNXUS_IMAGE_POSTGRES=pgvector/pgvector:pg17
LYNXUS_IMAGE_POSTGRES_BOOTSTRAP=postgres:17.6
LYNXUS_IMAGE_MINIO=minio/minio:RELEASE.2025-09-07T16-13-09Z
LYNXUS_IMAGE_TEMPORAL=temporalio/auto-setup:1.28.1
LYNXUS_IMAGE_TEMPORAL_UI=temporalio/ui:2.39.0
LYNXUS_IMAGE_CADDY=caddy:2.8.4-alpine

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/lynxus_api
SPRING_DATASOURCE_USERNAME=lynxus
SPRING_DATASOURCE_PASSWORD=lynxus

LYNXUS_MINIO_ENDPOINT=http://127.0.0.1:9000
LYNXUS_MINIO_ACCESS_KEY=minioadmin
LYNXUS_MINIO_SECRET_KEY=minioadmin
LYNXUS_KNOWLEDGE_DATABASE_URL=postgresql+psycopg://lynxus:lynxus@127.0.0.1:5432/lynxus_knowledge
LYNXUS_KNOWLEDGE_STORAGE_MODE=minio
LYNXUS_KNOWLEDGE_STORAGE_ROOT=/tmp/lynxus-knowledge
LYNXUS_KNOWLEDGE_MINIO_BUCKET=lynxus-knowledge
LYNXUS_KNOWLEDGE_DEFAULT_RETRIEVAL_MODE=HYBRID
LYNXUS_KNOWLEDGE_EMBEDDING_BASE_URL=http://localhost:11434/v1
LYNXUS_KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text
LYNXUS_KNOWLEDGE_EMBEDDING_API_KEY=change-me-if-required
LYNXUS_KNOWLEDGE_EMBEDDING_DIMENSIONS=768
LYNXUS_KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
LYNXUS_KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=15

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
LYNXUS_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
LYNXUS_OPENAI_COMPATIBLE_MODEL_ID=custom-compatible-model
LYNXUS_OPENAI_COMPATIBLE_API_KEY_ENV_VAR=OPENAI_COMPATIBLE_API_KEY
LYNXUS_OPENAI_COMPATIBLE_ORGANIZATION=compatible-lab
LYNXUS_OPENAI_COMPATIBLE_PROJECT=self-hosted
LYNXUS_OPENAI_COMPATIBLE_REGION=dev

LYNXUS_DEV_WEB_BIND_ADDRESS=0.0.0.0
LYNXUS_DEV_WEB_PORT=8080
LYNXUS_DEV_API_BIND_ADDRESS=0.0.0.0
LYNXUS_DEV_API_PORT=18080
LYNXUS_DEV_TEMPORAL_UI_BIND_ADDRESS=0.0.0.0
LYNXUS_DEV_TEMPORAL_UI_PORT=8088
LYNXUS_DEV_MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
LYNXUS_DEV_MINIO_CONSOLE_PORT=9001
LYNXUS_DEV_VITE_API_BASE_URL=/api
