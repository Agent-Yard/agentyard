# Development environment for shared server-side debugging and `deploy/dev`.
# Copy to `.env.dev` and adjust the parts that match your machine or dev host.

# ------------------------------------------------------------------------------
# Spring / log profile
# ------------------------------------------------------------------------------

SPRING_PROFILES_ACTIVE=dev
LYNXUS_LOG_FORMAT=json

# Optional per-service log level overrides.
# LYNXUS_AGENT_RUNTIME_LOG_LEVEL=INFO
# LYNXUS_KNOWLEDGE_SERVICE_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Web dev server and browser-facing origins
# ------------------------------------------------------------------------------

LYNXUS_WEB_HOST=0.0.0.0
LYNXUS_WEB_PORT=5173
LYNXUS_WEB_DEV_PROXY_TARGET=http://127.0.0.1:8080
LYNXUS_WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://devbox.example.com:5173,http://devbox.example.com:8080
LYNXUS_WEB_ALLOWED_HOSTS=devbox.example.com
LYNXUS_WEB_HMR_PROTOCOL=wss
LYNXUS_WEB_HMR_HOST=devbox.example.com
LYNXUS_WEB_HMR_CLIENT_PORT=443
# Optional: only set when the HMR websocket is exposed on a different upstream port than the browser-facing port.
# LYNXUS_WEB_HMR_PORT=5173

# ------------------------------------------------------------------------------
# Service listen ports used by local processes
# ------------------------------------------------------------------------------

LYNXUS_API_PORT=8080
LYNXUS_WORKER_PORT=8081
LYNXUS_CHANNEL_GATEWAY_PORT=8082
LYNXUS_CHANNEL_GATEWAY_BASE_URL=http://127.0.0.1:8082
LYNXUS_AGENT_RUNTIME_HOST=0.0.0.0
LYNXUS_AGENT_RUNTIME_PORT=8090
LYNXUS_AGENT_RUNTIME_BASE_URL=http://127.0.0.1:8090
LYNXUS_API_BASE_URL=http://127.0.0.1:8080/api
LYNXUS_SANDBOX_BASE_URL=http://127.0.0.1:8092
LYNXUS_KNOWLEDGE_SERVICE_HOST=0.0.0.0
LYNXUS_KNOWLEDGE_SERVICE_PORT=8091
LYNXUS_KNOWLEDGE_SERVICE_BASE_URL=http://127.0.0.1:8091

# Optional global instance id for non-compose local process debugging.
# Leave blank to use the default auto-generated value.
LYNXUS_INSTANCE_ID=

# ------------------------------------------------------------------------------
# Internal auth and platform auth
# ------------------------------------------------------------------------------

LYNXUS_INTERNAL_AUTH_TOKEN=change-me-in-dev
LYNXUS_INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=change-me-integration-credential-key
LYNXUS_AUTH_BOOTSTRAP_USERNAME=admin
LYNXUS_AUTH_DEFAULT_ROLE=BUSINESS_USER
LYNXUS_AUTH_DEV_BOOTSTRAP_ENABLED=true
LYNXUS_AUTH_LOGIN_SUCCESS_PATH=/

# OIDC example for Spring Security oauth2Login.
# When you disable dev bootstrap, at least one client registration must exist.
# Replace `CORP` with your chosen registration id if needed.
# LYNXUS_AUTH_DEV_BOOTSTRAP_ENABLED=false
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_CLIENT_ID=your-client-id
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_CLIENT_SECRET=your-client-secret
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_SCOPE=openid,profile,email
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_CORP_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}
# SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_CORP_ISSUER_URI=https://your-idp.example.com/realms/your-realm

# ------------------------------------------------------------------------------
# Redis and shared state
# ------------------------------------------------------------------------------

LYNXUS_REDIS_HOST=127.0.0.1
LYNXUS_REDIS_PORT=6379
LYNXUS_REDIS_DATABASE=0
LYNXUS_REDIS_USERNAME=
LYNXUS_REDIS_PASSWORD=lynxus
LYNXUS_REDIS_SSL_ENABLED=false
LYNXUS_REDIS_TIMEOUT=3s
LYNXUS_REDIS_HEALTH_CHECK_ENABLED=true

# Shared-state tuning for distributed locks, idempotency, and runtime SSE replay.
LYNXUS_SHARED_STATE_LOCK_TTL=10s
LYNXUS_SHARED_STATE_LOCK_ACQUIRE_TIMEOUT=3s
LYNXUS_SHARED_STATE_IDEMPOTENCY_TTL=24h
LYNXUS_SHARED_STATE_SSE_REPLAY_TTL=15m
LYNXUS_SHARED_STATE_SSE_REPLAY_LIMIT=128
LYNXUS_SHARED_STATE_STREAM_POLL_INTERVAL=1s

# ------------------------------------------------------------------------------
# API session storage and cookies
# ------------------------------------------------------------------------------

LYNXUS_SESSION_REDIS_NAMESPACE=lynxus:session:http
LYNXUS_SESSION_TIMEOUT=12h
LYNXUS_SESSION_COOKIE_NAME=LYNXUS_SESSION
LYNXUS_SESSION_COOKIE_PATH=/
LYNXUS_SESSION_COOKIE_SECURE=false
LYNXUS_SESSION_COOKIE_SAME_SITE=Lax

# ------------------------------------------------------------------------------
# Temporal and dependency images
# ------------------------------------------------------------------------------

LYNXUS_TEMPORAL_TARGET=127.0.0.1:7233
LYNXUS_TEMPORAL_UI_USERNAME=observer
LYNXUS_TEMPORAL_UI_PASSWORD=change-me-temporal-ui
LYNXUS_TEMPORAL_NAMESPACE=default
LYNXUS_TEMPORAL_TASK_QUEUE=lynxus-customer-ops
LYNXUS_TEMPORAL_SESSION_UPDATE_TIMEOUT=2m
LYNXUS_TEMPORAL_ACTIVITY_START_TO_CLOSE_TIMEOUT=PT2M

LYNXUS_IMAGE_POSTGRES=pgvector/pgvector:pg17
LYNXUS_IMAGE_POSTGRES_BOOTSTRAP=postgres:17.6
LYNXUS_IMAGE_MINIO=minio/minio:RELEASE.2025-09-07T16-13-09Z
LYNXUS_IMAGE_TEMPORAL=temporalio/auto-setup:1.28.1
LYNXUS_IMAGE_TEMPORAL_UI=temporalio/ui:2.39.0
LYNXUS_IMAGE_CADDY=caddy:2.8.4-alpine
LYNXUS_IMAGE_REDIS=redis:7.4-alpine
LYNXUS_IMAGE_SANDBOX=ghcr.io/agent-infra/sandbox:1.0.0.152

# ------------------------------------------------------------------------------
# Databases and object storage
# ------------------------------------------------------------------------------

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/lynxus_core
SPRING_DATASOURCE_USERNAME=lynxus
SPRING_DATASOURCE_PASSWORD=lynxus
LYNXUS_CHANNEL_GATEWAY_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/lynxus_channel_gateway

LYNXUS_OBJECT_STORAGE_MODE=object-storage
LYNXUS_OBJECT_STORAGE_ROOT=/tmp/lynxus-knowledge
LYNXUS_OBJECT_STORAGE_PROVIDER=minio
LYNXUS_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
LYNXUS_OBJECT_STORAGE_REGION=
LYNXUS_OBJECT_STORAGE_ACCESS_KEY=minioadmin
LYNXUS_OBJECT_STORAGE_SECRET_KEY=minioadmin
LYNXUS_OBJECT_STORAGE_BUCKET=lynxus-knowledge
LYNXUS_OBJECT_STORAGE_CREATE_BUCKET=true

# ------------------------------------------------------------------------------
# Knowledge service
# ------------------------------------------------------------------------------

LYNXUS_KNOWLEDGE_DATABASE_URL=postgresql+psycopg://lynxus:lynxus@127.0.0.1:5432/lynxus_knowledge
LYNXUS_KNOWLEDGE_DEFAULT_RETRIEVAL_MODE=HYBRID
LYNXUS_KNOWLEDGE_EMBEDDING_BASE_URL=http://localhost:11434/v1
LYNXUS_KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text
LYNXUS_KNOWLEDGE_EMBEDDING_API_KEY=change-me-if-required
LYNXUS_KNOWLEDGE_EMBEDDING_DIMENSIONS=768
LYNXUS_KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
LYNXUS_KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=15
LYNXUS_KNOWLEDGE_URL_IMPORT_TIMEOUT_SECONDS=15
LYNXUS_KNOWLEDGE_URL_IMPORT_USER_AGENT=LynxusKnowledgeService/2.0

# ------------------------------------------------------------------------------
# Agent runtime privacy mapping
# ------------------------------------------------------------------------------

# Required when privacy mapping is enabled.
LYNXUS_PRIVACY_SESSION_STORE_ENCRYPTION_KEY=change-me-privacy-key

# Usually keep the default unless you need isolation from another environment.
LYNXUS_PRIVACY_SESSION_STORE_KEY_PREFIX=lynxus:privacy:session

# Optional safety valve for semantic tool loops in agent runtime.
# Leave blank to use the built-in default.
LYNXUS_AGENT_RUNTIME_MAX_TOOL_STEPS=

# ------------------------------------------------------------------------------
# Model providers
# ------------------------------------------------------------------------------

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

LYNXUS_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
LYNXUS_OPENAI_COMPATIBLE_MODEL_ID=custom-compatible-model
LYNXUS_OPENAI_COMPATIBLE_API_KEY_ENV_VAR=OPENAI_COMPATIBLE_API_KEY
LYNXUS_OPENAI_COMPATIBLE_ORGANIZATION=compatible-lab
LYNXUS_OPENAI_COMPATIBLE_PROJECT=self-hosted
LYNXUS_OPENAI_COMPATIBLE_REGION=dev

# ------------------------------------------------------------------------------
# Browser-facing ports for `deploy/dev`
# ------------------------------------------------------------------------------

LYNXUS_DEV_WEB_BIND_ADDRESS=0.0.0.0
LYNXUS_DEV_WEB_PORT=8080
LYNXUS_DEV_API_BIND_ADDRESS=0.0.0.0
LYNXUS_DEV_API_PORT=18080
LYNXUS_DEV_CHANNEL_GATEWAY_BIND_ADDRESS=0.0.0.0
LYNXUS_DEV_CHANNEL_GATEWAY_PORT=18082
LYNXUS_DEV_API_BIND_ADDRESS_SECONDARY=127.0.0.1
LYNXUS_DEV_API_PORT_SECONDARY=18081
LYNXUS_DEV_TEMPORAL_UI_BIND_ADDRESS=0.0.0.0
LYNXUS_DEV_TEMPORAL_UI_PORT=8088
LYNXUS_DEV_MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
LYNXUS_DEV_MINIO_CONSOLE_PORT=9001
LYNXUS_DEV_REDIS_BIND_ADDRESS=127.0.0.1
LYNXUS_DEV_REDIS_PORT=6379
LYNXUS_DEV_VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# Explicit instance ids for `deploy/dev --profile multi-instance`
# ------------------------------------------------------------------------------

# These ids show up in logs, health payloads, and shared-state tracing.
LYNXUS_API_INSTANCE_ID=api-1
LYNXUS_API_INSTANCE_ID_SECONDARY=api-2
LYNXUS_WORKER_INSTANCE_ID=worker-1
LYNXUS_WORKER_INSTANCE_ID_SECONDARY=worker-2
LYNXUS_AGENT_RUNTIME_INSTANCE_ID=agent-runtime-1
LYNXUS_AGENT_RUNTIME_INSTANCE_ID_SECONDARY=agent-runtime-2
LYNXUS_KNOWLEDGE_INSTANCE_ID=knowledge-service-1
LYNXUS_KNOWLEDGE_INSTANCE_ID_SECONDARY=knowledge-service-2
