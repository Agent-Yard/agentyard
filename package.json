{
  "name": "lynxus",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "local": "./scripts/local/all.sh",
    "local:all": "./scripts/local/all.sh",
    "local:api": "./scripts/local/api.sh",
    "local:worker": "./scripts/local/worker.sh",
    "local:knowledge-service": "./scripts/local/knowledge-service.sh",
    "local:agent-runtime": "./scripts/local/agent-runtime.sh",
    "local:web": "./scripts/local/web.sh",
    "dev": "docker compose --env-file .env.dev -f infra/dev/docker-compose.yml up --build -d",
    "dev:all": "docker compose --env-file .env.dev -f infra/dev/docker-compose.yml up --build -d",
    "dev:up": "docker compose --env-file .env.dev -f infra/dev/docker-compose.yml up --build -d",
    "dev:down": "docker compose --env-file .env.dev -f infra/dev/docker-compose.yml down",
    "dev:logs": "docker compose --env-file .env.dev -f infra/dev/docker-compose.yml logs -f --tail=200",
    "dev:source": "./scripts/dev/all.sh",
    "dev:source:all": "./scripts/dev/all.sh",
    "dev:source:api": "./scripts/dev/api.sh",
    "dev:source:worker": "./scripts/dev/worker.sh",
    "dev:source:knowledge-service": "./scripts/dev/knowledge-service.sh",
    "dev:source:agent-runtime": "./scripts/dev/agent-runtime.sh",
    "dev:source:web": "./scripts/dev/web.sh",
    "build:web": "pnpm --filter @lynxus/web build",
    "test:web": "pnpm --filter @lynxus/web test",
    "lint:web": "pnpm --filter @lynxus/web lint"
  }
}
