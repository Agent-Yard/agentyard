{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "briefing",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "docs/briefing", "-l", "3456", "--no-clipboard"],
      "port": 3456
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@agentyard/site", "dev", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@agentyard/site", "preview", "--port", "4173", "--strictPort"],
      "port": 4173
    }
  ]
}
